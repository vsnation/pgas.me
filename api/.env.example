# Pgas.me API — every knob, with its default. Copy to .env and edit. NO real secrets in this file.
# Everything that moves money is OFF unless armed explicitly (see the "Arming" block).

# --- process ---------------------------------------------------------------------------------
PGAS_ENV=dev                         # dev | test | prod (prod hides /v1/docs)
PGAS_HOST=127.0.0.1
PGAS_PORT=8300
PGAS_WORKERS_ENABLED=1               # deposit_watcher / monitor / stats_refresher inside the API process
PGAS_DEV_ENDPOINTS=0                 # 1 mounts POST /v1/dev/credit (seed a balance) — NEVER in prod
PGAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PGAS_STOP_FILE=/etc/pgasme.stop      # kill switch: while this file exists the workers pause and change nothing

# --- storage ---------------------------------------------------------------------------------
PGAS_MONGO_URL=mongodb://127.0.0.1:27017/pgasme

# --- sign-in with Ethereum (EIP-4361) ---------------------------------------------------------
PGAS_SIWE_DOMAINS=localhost:5173,127.0.0.1:5173,pgas.me,www.pgas.me
PGAS_SIWE_STATEMENT=Sign in to Pgas.me. This signature costs nothing and moves nothing.
PGAS_JWT_SECRET=change-me-32-random-bytes          # HS256 session tokens
PGAS_ACCOUNT_SALT=change-me-another-32-random-bytes  # account_id = keccak(lowercase address | salt)
PGAS_SESSION_TTL_S=86400
PGAS_NONCE_TTL_S=300

# --- cross-chain order router (read-only HTTP; the user signs the order) ----------------------
# Leave these unset to use the shipped defaults. Only the neutral PGAS_XCHAIN_* names are
# supported going forward; an older deprecated spelling is still read for one release so a host
# provisioned before the rename keeps working, and is not documented here.
# ⚠️ COMMENTED OUT ON PURPOSE: an empty value is not "use the default", it IS an empty base and
# every quote then fails. Uncomment only to point the client somewhere else.
#PGAS_XCHAIN_BASE=
#PGAS_XCHAIN_MIRROR=
#PGAS_XCHAIN_STATS_BASE=
PGAS_XCHAIN_AFFILIATE_FEE_PERCENT=0  # > 0 together with the recipient adds affiliateFee* to every order
PGAS_XCHAIN_AFFILIATE_RECIPIENT=
PGAS_XCHAIN_REFERRAL_CODE=84
PGAS_XCHAIN_SLIPPAGE=1.0
PGAS_XCHAIN_TIMEOUT_S=25
PGAS_QUOTE_TTL_S=900                 # a quote (and its armed tx) is valid for 15 min

# --- Ethereum --------------------------------------------------------------------------------
# Measured 2026-09-09: flashbots never serves logs at head, ankr needs an API key, llamarpc answers 525.
PGAS_ETH_RPCS=https://rpc.mevblocker.io,https://eth.drpc.org,https://ethereum-rpc.publicnode.com,https://1rpc.io/eth
PGAS_ETH_CHAIN_ID=1
PGAS_ETHPIPE_ADDRESS=0xB1d7FF9D3aCaf30e282c5F6eb1F2A6503f516a96   # EthPipe (native ETH); DAI/WBTC pipes are in assets.py
PGAS_LOCK_CONFIRMATIONS=12           # blocks on top of the NewLocalMessage lock before a credit
PGAS_HOOK_GAS=250000                 # gas the cross-chain hook reserves for sendFunds
PGAS_LOCK_SCAN_BLOCKS=2000           # how far back the watcher scans the pipe for the lock log
PGAS_LOCK_SCAN_CHUNK=50              # eth_getLogs block range per request (most public providers refuse 500)

# --- Uniswap V4 ingress (one transaction: swap on our gateway pool, the hook pipes the output) -
# EVERY address here is EMPTY by default and none of them is ever guessed: with any of the three
# unset the route refuses and /v1/health says ingress.uniswap=false. Both ingress flags sit UNDER
# PGAS_INGRESS_ARMED and the kill switch — they choose which ways in the API SERVES, never
# whether money may move. Turning one off refuses NEW quotes only: a deposit already in flight is
# still watched, attributed and credited, because a paused route must never strand one.
PGAS_INGRESS_UNISWAP=0               # 1 = POST /v1/quote may answer mode "uniswap"
PGAS_INGRESS_XCHAIN=1                # 0 = cross-chain quotes and /arm answer 409 (paused)
PGAS_UNISWAP_HOOK=                   # PgasIngressHook — its low 14 address bits are 0x2888
PGAS_UNISWAP_ROUTER=                 # PgasRouter — the `to` of every deposit transaction we issue
PGAS_UNISWAP_QUOTER=                 # the chain's deployed V4Quoter; read with eth_call, never written
PGAS_UNISWAP_SLIPPAGE_BPS=50         # min_out = out × (1 − bps/10000), enforced by the hook itself
PGAS_UNISWAP_MAX_UPSIDE_BPS=500      # how far ABOVE the quote a pipe lock may still be this deposit's
# The registry, as JSON. `gateway_pool_key` is OUR zero-liquidity pool (fee 0, tickSpacing 1,
# hooks = PGAS_UNISWAP_HOOK); `inner_pool_key` is the canonical DEEP HOOK-LESS pool the swap really
# happens on. Both name the same pair in Uniswap's sorted order, `token_in` is the input side for
# `zero_for_one`, and the output side must be the target asset's own token.
# ⚠️ `max_deposit_units` is RE-DERIVED from the inner pool's live depth before each arming (≤ 1 % of
# the ±0.5 % band) — never a flat cap carried over from a previous run: a pool initialised with zero
# liquidity looks real and pays nothing, so depth is read, not assumed.
# PGAS_UNISWAP_POOLS=[{"token_in":"0x…","symbol":"USDC","decimals":6,"gateway_pool_key":{"currency0":"0x…","currency1":"0x…","fee":0,"tickSpacing":1,"hooks":"0x…"},"inner_pool_key":{"currency0":"0x…","currency1":"0x…","fee":3000,"tickSpacing":60,"hooks":"0x0000000000000000000000000000000000000000"},"zero_for_one":false,"target":"ETH","max_deposit_units":"500000000","min_deposit_units":"1","min_relayer_fee_units":"0","max_relayer_fee_bps":"500"}]
PGAS_UNISWAP_POOLS=[]

# --- Arming (PGAS_INGRESS_ARMED=1 AND the pubkey of THAT asset's pipe → /v1/quote returns a tx) -
# The receiver pubkey is derived from (our wallet master key, pipe cid): one per pipe, 66 hex chars,
# from wallet-api `role=user,action=get_pk,cid=<that pipe's cid>` (the PIPE cid, never the asset-owner cid).
# An asset without a pubkey quotes unarmed (estimate + note) even when armed.
PGAS_INGRESS_ARMED=0                 # 1 = quotes carry a real order tx whose hook locks funds in the pipe
PGAS_BEAM_PIPE_PUBKEY_ETH=           # ETH pipe (PGAS_BEAM_PIPE_PUBKEY is the legacy name for the same value)
PGAS_BEAM_PIPE_PUBKEY_DAI=
PGAS_BEAM_PIPE_PUBKEY_WBTC=
PGAS_BEAM_PIPE_PUBKEY=
# ⛔ THE WALLET-API IS CALLED FOR EXACTLY TWO THINGS (law 10, admin 2026-09-09: "Avoid using
# wallet-api. Only Beampay as it counts all balances"): `invoke_contract` with create_tx:false
# (building pipe calldata — signs nothing) and `process_invoke_data` (the irreversible submit).
# Balances, transactions, statuses, addresses, withdrawals and shielding are BeamPay's below.
# Anything else against :10001 is a defect — "so you won't have glitches in balances".
PGAS_BEAM_WALLET_API=http://127.0.0.1:10001/api/wallet   # invoke_contract(create_tx:false) + process_invoke_data ONLY

# --- BeamPay: THE interface to the Beam wallet's money -----------------------------------------
# The Pgas instance runs on the box at 127.0.0.1:8010 with its own Mongo db (`pgasme_beampay`).
# TWO keys, and they are not interchangeable: `/internal/*` (expect_contract_tx, contract_tx)
# demands a key scoped `ledger:adjust` and refuses the ordinary scopeless one with 403 — by
# design, so a new route can never hand an existing integration key a new power. The client
# fails closed rather than sending the wrong one.
PGAS_BEAMPAY_URL=http://127.0.0.1:8010
PGAS_BEAMPAY_KEY=                    # the ordinary key: /balances, /transactions, /withdraw, /create_wallet
PGAS_BEAMPAY_INTERNAL_KEY=           # the SCOPED key (ledger:adjust): /internal/expect_contract_tx, /internal/contract_tx
# ⛔ Unset, unscoped (403) or missing from the BeamPay build (master e09bfc2 has NO /internal/*
# routes at all) and NOTHING is signed: every release and every claim refuses with a written
# reason, because a contract txid that cannot be registered books its whole flow — the asset AND
# the BEAM fee — to __house__, and that repair can only be refused after the money has moved.
# The probe is `GET /internal/expect_contract_tx`, asked once per processor pass.
PGAS_BEAMPAY_TIMEOUT_S=20
# --- BeamPay -> us: the webhook credential ------------------------------------------------------
# BeamPay posts every money event to POST /internal/beampay/webhook and sends NO auth header, so
# the only credential it can carry is the one in the URL it was configured with. Generate one
# (`openssl rand -hex 32`), put it here, and give BeamPay the SAME value in its own .env:
#
#   BEAMPAY_WEBHOOK_URLS=http://127.0.0.1:8300/internal/beampay/webhook?token=<the same value>
#
# The two must match exactly, and neither is ever printed, logged or committed — the query string
# of every /internal/ access-log line is redacted (pgasme/main.py) for that reason.
# UNSET IS A REFUSAL: the route answers 503 and records nothing, because an unauthenticated
# writer of the evidence log is worse than a missing notification. Set it, then restart the API.
# ⚠️ A URL BeamPay cannot deliver to is not a quiet failure: its worker pages the operator's
# Telegram group on EVERY failed attempt and retries the record ~20 times (2026-09-10: seven
# "Webhook Failed" messages in minutes for one transaction). Wrong token = 401 = that flood.
# The endpoint only records; no credit, no deposit or payout change ever comes from a webhook.
PGAS_BEAMPAY_WEBHOOK_TOKEN=
# The regular address every claim books to and every shield spends from. Its BeamPay balance is
# the truth for claimed-but-not-yet-shielded value AND for the BEAM every claim, shield and pipe
# send is paid for. A balance read with no address is not a zero: every read RAISES while it is
# empty. Created through BeamPay (`POST /create_wallet {wallet_type: regular}`), never elsewhere.
PGAS_BEAM_TREASURY_ADDRESS=
PGAS_MIN_RELAYER_FEE_WEI=100000000000            # ETH: the smallest relayerFee ridden on the tail (1e11 wei)
PGAS_MIN_RELAYER_FEE_DAI_UNITS=200000000000000   # DAI: 0.0002 DAI
PGAS_MIN_RELAYER_FEE_WBTC_UNITS=1                # WBTC: 1 sat

# --- product economics -----------------------------------------------------------------------
PGAS_FEE_BPS=200                     # 2% at unlock, charged to the balance
PGAS_MIN_DEPOSIT_WEI=20000000000000000   # 0.02 ETH (ETH-equivalent for DAI/WBTC via CoinGecko)
PGAS_MIN_PAYOUT_GROTH=1000000        # 0.01 per wallet — the FLOOR under the derived minimum;
                                     # a payout must also clear ceil(relayer_fee_now*10000/FEE_BPS)
                                     # (the bridge fee is paid out of our 2%) — GET /v1/withdrawals/fees
PGAS_DENOMINATIONS_GROTH=1000000,10000000   # instant-mode denominations (0.01, 0.1)
PGAS_BRIDGE_ETA_S=3960               # 66 min: an order wanted at T is released at T - this
PGAS_MAX_WINDOW_S=2592000            # 30 days — also the furthest ahead a delivery may be scheduled
PGAS_MAX_ITEMS_PER_WITHDRAWAL=50

# --- payout execution (DARK in this version; the API refuses the mode with 409 while 0) ------
PGAS_PAYOUT_DIRECT_ENABLED=0         # gates `releasing` only: the bETH -> ETH send to the user's W
PGAS_PAYOUT_INSTANT_ENABLED=0        # gates the v1.1 any-asset branch (distributor + swap); unimplemented
PGAS_INGRESS_NEAR_ENABLED=0

# --- Beam treasury + the order processors (pgasme/payouts.py) ---------------------------------
# EVERY money-moving flag here is 0 by default. With a flag off the handler logs what it WOULD
# do, marks the order `dark` and pages once an hour that treasury work is waiting. The operator
# flips these, after a dry run (`python -m pgasme.beam dry-run --payout <id>`), smallest first.
PGAS_CLAIM_ENABLED=0                 # 1 = `receive` the pipe message on Beam (spends 0.02 BEAM)
PGAS_SHIELD_ENABLED=0                # 1 = max-privacy self-sends into the pool (0.011 BEAM each)
PGAS_BEAM_SHADER=/opt/pgasme/beam/pipe_app.wasm   # the FORWARD pipe shader on the box
PGAS_BEAM_WALLET_TIMEOUT_S=30
# Shield denominations are a VALUE, not a number: 0.01/0.1 ETH is a crowd, and the same
# integers read as 0.01/0.1 DAI — 10,000 sends and 110 BEAM of fees for one 1000-DAI deposit.
PGAS_SHIELD_DENOMS_GROTH=1000000,10000000         # ETH:  0.01 / 0.1 ETH chunks
PGAS_SHIELD_DENOMS_DAI_GROTH=1000000000,10000000000   # DAI:  10 / 100 DAI
PGAS_SHIELD_DENOMS_WBTC_GROTH=1000000,10000000    # WBTC: 0.01 / 0.1 WBTC
PGAS_SHIELD_MAX_CHUNKS=64            # a longer plan is REFUSED and held, never emitted
PGAS_FLOAT_MIN_GROTH=0               # reserve kept in the shielded float; a release never eats it
PGAS_PAYOUT_INTERVAL_S=30            # the payout_processor loop
PGAS_PAYOUT_LEASE_TTL_S=120          # one writer per resource: a second loop refuses to run
PGAS_HOLD_BACKOFF_S=300              # a row that just held is not re-read for this long
PGAS_BEAM_CONFIRMATIONS=61           # b2e: the relayer acts after ~61 Beam confirmations (~60 min)
# ⚠️ THESE TWO ARE BUDGETS, NOT SETTINGS (§WE-SET-IT-WE-DONT-READ-IT). They are what a pass
# RESERVES out of the treasury's asset-0 balance as BeamPay reports it, before it spends — so N
# calls cannot be admitted against one balance read. Neither reaches any wallet call: no `fee` is
# sent on invoke_contract (the WALLET sets it, exactly as arb_tracker's movers build theirs) and
# BeamPay overrides and ignores the fee field on /withdraw (it charges 0.001 BEAM to a regular
# address, 0.011 to an offline/max-privacy one). The fee actually charged is READ BACK from
# BeamPay once the transaction is booked and recorded on the row.
PGAS_BEAM_CLAIM_FEE_GROTH=2000000    # budget per contract invocation (claim / pipe send)
PGAS_BEAM_SHIELD_FEE_GROTH=1100000   # budget per shield chunk (BeamPay charges 0.011 to max_privacy)
PGAS_BEAM_FEE_ALERT_GROTH=500000000  # 5 BEAM — the scale at which fee money matters, BOTH ways:
                                     # page below it in BALANCE (a starving wallet), and page
                                     # above it in ONE FEE read back (a fee nobody should pay)
PGAS_BEAM_MP_ADDRESS=                # our PRIMARY max_privacy address, created THROUGH BeamPay
                                     # (`/create_wallet {wallet_type: max_privacy}`) so its
                                     # balance is one BeamPay can report. Created once and
                                     # stored if empty.
                                     # ⚠️ IT IS NOT WHERE A SHIELD CHUNK IS SENT. 2026-09-09
                                     # 23:21–23:23Z: three max-privacy self-sends to THIS
                                     # address seconds apart — chunk 0 settled, chunks 1 and 2
                                     # came back "Shielded outp duplicate ← Kernel Type 3"
                                     # (status 4, failed maximum anonymity). A max-privacy
                                     # address publishes ONE-TIME vouchers and the wallet
                                     # re-used one for every send. So each chunk now gets its
                                     # OWN fresh max_privacy address, registered in the
                                     # `mp_addresses` collection, and the SHIELDED FLOAT is the
                                     # SUM of `available` over that registry PLUS this address.
                                     # This one stays load-bearing: it is the registry's first
                                     # entry and the address a release registers its contract
                                     # txid to, so BeamPay books the crossing and its BEAM fee
                                     # there.
                                     # ⚠️ PROVEN before any chunk, and BeamPay's
                                     # /validate_address answers only `is_valid`, so the proof is
                                     # valid · in BeamPay's own address book (the `is_mine`
                                     # substitute, and what makes the float readable at all) ·
                                     # NOT a 64/66-hex regular address (shielding to one settles
                                     # and shields nothing). A typo here otherwise sends every
                                     # claimed deposit to a stranger, one settled kernel at a time
                                     # Repair a shielding that failed:
                                     #   python -m pgasme.beam replan-shield --deposit <id>
                                     #   …then the same with --apply (a dry run writes nothing)
PGAS_RELAYER_FEE_MARGIN=1.5          # bridge_fee.py FEE_MARGIN — insurance against REFUSAL, not speed
PGAS_MAX_RELAYER_SHARE=0.10          # refuse a crossing whose relayer fee exceeds this share of the amount
PGAS_MAX_RELAYER_SUBSIDY=1.0         # …and this multiple of the 2% we actually charged. 1.0 =
                                     # never cross at a loss (the treasury's own guard; the
                                     # share gate only ever protected the user's amount)
# §9.3 / spec question S2 is UNANSWERED: nobody has proven which inputs the wallet picks for a
# `role=user,action=send` invocation. While this is 0 a release refuses whenever ANY unshielded
# balance of that asset exists — a send funded from a freshly-claimed regular output is the
# deposit↔payout link the product exists to prevent. Prove it on the box, then set it.
PGAS_BEAM_SEND_INPUTS_PROVEN=0
PGAS_BEAM_REGULAR_TOLERANCE_GROTH=0  # dust of unshielded balance the proof allows to be ignored

# --- external reads --------------------------------------------------------------------------
PGAS_EXPLORER_BASE=https://beamsmart.net:8000    # /status → shielded pool numbers
PGAS_COINGECKO_BASE=https://api.coingecko.com/api/v3

# --- workers ---------------------------------------------------------------------------------
PGAS_WATCHER_INTERVAL_S=15
PGAS_MONITOR_INTERVAL_S=60
PGAS_STATS_INTERVAL_S=60
PGAS_DEPOSIT_FALLBACK_AFTER_S=1800   # Fulfilled with no lock log for 30 min → fallback_pending

# --- Telegram (DEFAULT-DENY: nothing is sent unless PGAS_TG_LIVE=1 AND token AND chat id) ----
# ⚠️ "never logged" is now ENFORCED, not promised: on 2026-09-10 httpx's INFO logger wrote the
# send url — which carries this token — into the API's log file 21 times. pgasme/main.py holds
# httpx/httpcore at WARNING and masks `bot<digits>:<secret>` in every log record either way.
PGAS_TG_BOT_TOKEN=                   # bot token — only in the server .env, never logged
PGAS_TG_CHAT_ID=                     # operator group / chat id
PGAS_TG_LIVE=0                       # 1 = really send; anything else logs [tg-muted] and sends nothing
