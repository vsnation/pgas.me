# Pgas.me API — every knob, with its default. Copy to .env and edit. NO real secrets in this file.
# Everything that moves money is OFF unless armed explicitly (see the "Arming" block).

# --- process ---------------------------------------------------------------------------------
PGAS_ENV=dev                         # dev | test | prod (prod hides /v1/docs)
PGAS_HOST=127.0.0.1
PGAS_PORT=8300
PGAS_WORKERS_ENABLED=1               # deposit_watcher / monitor / stats_refresher inside the API process
PGAS_DEV_ENDPOINTS=0                 # 1 mounts POST /v1/dev/credit (seed a balance) — NEVER in prod
PGAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PGAS_STOP_FILE=/etc/pgasme.stop      # kill switch: while this file exists the workers pause and change nothing

# --- storage ---------------------------------------------------------------------------------
PGAS_MONGO_URL=mongodb://127.0.0.1:27017/pgasme

# --- sign-in with Ethereum (EIP-4361) ---------------------------------------------------------
PGAS_SIWE_DOMAINS=localhost:5173,127.0.0.1:5173,pgas.me,www.pgas.me
PGAS_SIWE_STATEMENT=Sign in to Pgas.me. This signature costs nothing and moves nothing.
PGAS_JWT_SECRET=change-me-32-random-bytes          # HS256 session tokens
PGAS_ACCOUNT_SALT=change-me-another-32-random-bytes  # account_id = keccak(lowercase address | salt)
PGAS_SESSION_TTL_S=86400
PGAS_NONCE_TTL_S=300

# --- the operator's read-only admin panel (GET /admin/*) --------------------------------------
# EMPTY IS A REFUSAL, NEVER AN OPEN DOOR: unset — or shorter than 32 characters, which is not a
# secret — makes every /admin route answer the 404 an unrouted path answers, so nothing about the
# panel is discoverable. Generate with `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`,
# keep it 0600, and never log, print or commit it. Five wrong keys from one address inside
# PGAS_RATE_WINDOW_S answer 429 and page the operator once.
PGAS_ADMIN_KEY=

# --- cross-chain order router (read-only HTTP; the user signs the order) ----------------------
# Leave these unset to use the shipped defaults. Only the neutral PGAS_XCHAIN_* names are
# supported going forward; an older deprecated spelling is still read for one release so a host
# provisioned before the rename keeps working, and is not documented here.
# ⚠️ COMMENTED OUT ON PURPOSE: an empty value is not "use the default", it IS an empty base and
# every quote then fails. Uncomment only to point the client somewhere else.
#PGAS_XCHAIN_BASE=
#PGAS_XCHAIN_MIRROR=
#PGAS_XCHAIN_STATS_BASE=
PGAS_XCHAIN_AFFILIATE_FEE_PERCENT=0  # > 0 together with the recipient adds affiliateFee* to every order
PGAS_XCHAIN_AFFILIATE_RECIPIENT=
PGAS_XCHAIN_REFERRAL_CODE=84
PGAS_XCHAIN_SLIPPAGE=1.0
PGAS_XCHAIN_TIMEOUT_S=25
PGAS_QUOTE_TTL_S=900                 # a quote (and its armed tx) is valid for 15 min

# --- Ethereum --------------------------------------------------------------------------------
# Measured 2026-09-09: flashbots never serves logs at head, ankr needs an API key, llamarpc answers 525.
PGAS_ETH_RPCS=https://rpc.mevblocker.io,https://eth.drpc.org,https://ethereum-rpc.publicnode.com,https://1rpc.io/eth
PGAS_ETH_CHAIN_ID=1
PGAS_ETHPIPE_ADDRESS=0xB1d7FF9D3aCaf30e282c5F6eb1F2A6503f516a96   # EthPipe (native ETH); DAI/WBTC pipes are in assets.py
PGAS_LOCK_CONFIRMATIONS=12           # blocks on top of the NewLocalMessage lock before a credit
PGAS_HOOK_GAS=250000                 # gas the cross-chain hook reserves for sendFunds
PGAS_LOCK_SCAN_BLOCKS=2000           # how far back the watcher scans the pipe for the lock log
PGAS_LOCK_SCAN_CHUNK=50              # eth_getLogs block range per request (most public providers refuse 500)

# A registered transaction NO endpoint of the pool can see yet (2026-09-10 incident: the first
# entry above is a private-orderflow relay that never exposes pending transactions, so a real
# 0.002 ETH deposit read as "does not exist" and was refused — twice, and both mined anyway).
# Registration now opens the row `verified: false` instead of refusing, and every watcher pass
# asks the WHOLE pool again; these two bound how that ends.
PGAS_UNSEEN_TX_TTL_S=7200            # how long a hash nobody can see may wait before the row is failed + paged
PGAS_QUOTE_ATTRIBUTION_WINDOW_S=86400  # how far back the scanner looks for the QUOTE whose sendFunds calldata a pipe lock carries
PGAS_TX_LOOKUP_DEADLINE_S=6            # wall-clock ceiling on asking the WHOLE pool for one transaction (they are asked concurrently)
# …and because an unseen hash now WRITES a row, registration is capped. A session is free (any
# key can sign in), so without these one script could fill the collection and the pager.
PGAS_DEPOSIT_ACCOUNT_LIMIT=10          # POST /v1/deposits per account per PGAS_RATE_WINDOW_S
PGAS_DEPOSIT_IP_LIMIT=30               # …and per calling address, for a fresh wallet per attempt

# --- Uniswap V4 ingress (one transaction: swap on our gateway pool, the hook pipes the output) -
# EVERY address here is EMPTY by default and none of them is ever guessed: with any of the three
# unset the route refuses and /v1/health says ingress.uniswap=false. Both ingress flags sit UNDER
# PGAS_INGRESS_ARMED and the kill switch — they choose which ways in the API SERVES, never
# whether money may move. Turning one off refuses NEW quotes only: a deposit already in flight is
# still watched, attributed and credited, because a paused route must never strand one.
PGAS_INGRESS_UNISWAP=0               # 1 = POST /v1/quote may answer mode "uniswap"
PGAS_INGRESS_XCHAIN=1                # 0 = cross-chain quotes and /arm answer 409 (paused)
# Which route `route:"auto"` (and an omitted route) resolves to when BOTH of the two above are
# open: xchain | uniswap. It is a preference, never a fourth flag — it can only choose between
# routes those flags have already opened, and the API clamps it to an open one before publishing
# it as ingress.default_route on /v1/health, /v1/dex/assets and /v1/account (which is what the
# client's route control preselects). An unknown value REFUSES AT BOOT rather than falling back
# quietly: a toggle that silently does nothing is worse than one that says it is misspelled.
PGAS_INGRESS_DEFAULT_ROUTE=xchain
# ── The TWO-STEP route (what `uniswap` MEANS by default): the user swaps their token for the
# target asset on UNISWAP'S OWN Universal Router, into their OWN wallet, and then deposits what
# actually arrived through the unchanged `direct` path. Nothing of ours is deployed on it, step 1
# is never a deposit and is never armed, and the only protection on it is `amountOutMinimum`
# (the V4 Quoter's answer less PGAS_UNISWAP_SLIPPAGE_BPS — never zero).
# The four addresses are Uniswap's canonical MAINNET deployments and are PINNED IN CODE at these
# values; set them only for a fork or a test chain. `contracts/test/fork/UniswapTwoStep.t.sol`
# proves each one on chain (code + a discriminating view) and executes the API's own calldata
# through the router.
PGAS_UNISWAP_UNIVERSAL_ROUTER=0x66a9893cC07D91D95644AEDD05D03f95e1dBA8Af   # v4-capable; poolManager() answers
PGAS_UNISWAP_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3            # how the router pulls an ERC-20 in
PGAS_UNISWAP_POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90       # read with extsload: slot0 + liquidity
PGAS_UNISWAP_QUOTER=0x52F0E24D1c21C8A0cB1e5a5dD6198556BD9E1203             # the deployed V4Quoter; eth_call only
PGAS_UNISWAP_DEADLINE_S=1200         # the swap's deadline AND the Permit2 expiry it is granted — one number
PGAS_UNISWAP_SLIPPAGE_BPS=50         # min_out = out × (1 − bps/10000); a zero bound is refused, never defaulted
# ── The ONE-TRANSACTION HOOK route: reviewed, NOT DEPLOYED, and off. Turning it on needs the two
# addresses below AND a `gateway_pool_key` on every registry row; with it off both are ignored.
PGAS_UNISWAP_HOOK_ENABLED=0          # 1 = `uniswap` means the hook shape instead of the two-step one
PGAS_UNISWAP_HOOK=                   # PgasIngressHook — its low 14 address bits are 0x2888
PGAS_UNISWAP_ROUTER=                 # PgasRouter — the `to` of every deposit transaction that shape issues
PGAS_UNISWAP_MAX_UPSIDE_BPS=500      # hook shape only: how far ABOVE the quote a pipe lock may still be this deposit's
# The registry, as JSON. `inner_pool_key` is the canonical DEEP HOOK-LESS pool the swap really
# happens on, and it is the only pool the two-step route uses. `gateway_pool_key` is OUR
# zero-liquidity pool (fee 0, tickSpacing 1, hooks = PGAS_UNISWAP_HOOK) and is read ONLY with
# PGAS_UNISWAP_HOOK_ENABLED=1 — a row left over from that shape still parses with it off.
# The pair is in Uniswap's sorted order, `token_in` is the input side for `zero_for_one`, and the
# output side must be the target asset's own token.
# ⚠️ `max_deposit_units` is RE-DERIVED from the inner pool's live depth before each arming (≤ 1 % of
# the ±0.5 % band) — never a flat cap carried over from a previous run: a pool initialised with zero
# liquidity looks real and pays nothing, so depth is read, not assumed.
# PGAS_UNISWAP_POOLS=[{"token_in":"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48","symbol":"USDC","decimals":6,"inner_pool_key":{"currency0":"0x0000000000000000000000000000000000000000","currency1":"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48","fee":3000,"tickSpacing":60,"hooks":"0x0000000000000000000000000000000000000000"},"zero_for_one":false,"target":"ETH","max_deposit_units":"500000000","min_deposit_units":"1000000"}]
# …and the same row for the hook shape, which additionally needs `gateway_pool_key`, `min_relayer_fee_units` and `max_relayer_fee_bps`:
# PGAS_UNISWAP_POOLS=[{"token_in":"0x…","symbol":"USDC","decimals":6,"gateway_pool_key":{"currency0":"0x…","currency1":"0x…","fee":0,"tickSpacing":1,"hooks":"0x…"},"inner_pool_key":{"currency0":"0x…","currency1":"0x…","fee":3000,"tickSpacing":60,"hooks":"0x0000000000000000000000000000000000000000"},"zero_for_one":false,"target":"ETH","max_deposit_units":"500000000","min_deposit_units":"1","min_relayer_fee_units":"0","max_relayer_fee_bps":"500"}]
PGAS_UNISWAP_POOLS=[]

# --- Arming (PGAS_INGRESS_ARMED=1 AND the pubkey of THAT asset's pipe → /v1/quote returns a tx) -
# The receiver pubkey is derived from (our wallet master key, pipe cid): one per pipe, 66 hex chars,
# from wallet-api `role=user,action=get_pk,cid=<that pipe's cid>` (the PIPE cid, never the asset-owner cid).
# An asset without a pubkey quotes unarmed (estimate + note) even when armed.
PGAS_INGRESS_ARMED=0                 # 1 = quotes carry a real order tx whose hook locks funds in the pipe
PGAS_BEAM_PIPE_PUBKEY_ETH=           # ETH pipe (PGAS_BEAM_PIPE_PUBKEY is the legacy name for the same value)
PGAS_BEAM_PIPE_PUBKEY_DAI=
PGAS_BEAM_PIPE_PUBKEY_WBTC=
PGAS_BEAM_PIPE_PUBKEY=
# ── ONE RECEIVER KEY PER DEPOSIT (WO-20260910-3). Off: every quote is armed with the pipe's
# legacy key above, and the calldata, the quote row and the claim are byte-for-byte what they
# were. On: each armed direct/cross-chain quote allocates its own index and the calldata names
# `get_pk(cid, index)`; the quote row keeps `receiver_index`/`receiver_pk`, the deposit row
# carries the index, and the claim signs with it.
# ⛔ IT GATES ISSUANCE, NOT RECOGNITION — turning it off never stops the scanner recognising,
#    the watcher looking for, or the claim signing for a key already issued. A deposit on its
#    way to an unrecognised key has NO refund path.
# ⛔ IT NEEDS THE PATCHED PIPE APP AT PGAS_BEAM_SHADER, AND THE TWO ARE FLIPPED TOGETHER. The
#    shipped one ignores `index=` and answers the legacy key for every index, so the API refuses
#    that answer: with this on and the stock wasm still configured, every armed quote answers
#    503 instead of quietly issuing one shared receiver key under N different index numbers.
# ⛔ THE UNISWAP/HOOK ROUTE IS EXCLUDED and stays on the legacy key: `beamPubkey` is pinned on
#    the route on-chain, write-once, and `hookData` deliberately cannot carry one.
PGAS_RECEIVER_KEY_PER_DEPOSIT=0
# ⛔ THE WALLET-API IS CALLED FOR EXACTLY TWO THINGS (law 10, admin 2026-09-09: "Avoid using
# wallet-api. Only Beampay as it counts all balances"): `invoke_contract` with create_tx:false
# (building pipe calldata — signs nothing) and `process_invoke_data` (the irreversible submit).
# Balances, transactions, statuses, addresses, withdrawals and shielding are BeamPay's below.
# Anything else against :10001 is a defect — "so you won't have glitches in balances".
PGAS_BEAM_WALLET_API=http://127.0.0.1:10001/api/wallet   # invoke_contract(create_tx:false) + process_invoke_data ONLY

# --- BeamPay: THE interface to the Beam wallet's money -----------------------------------------
# The Pgas instance runs on the box at 127.0.0.1:8010 with its own Mongo db (`pgasme_beampay`).
# TWO keys, and they are not interchangeable: `/internal/*` (expect_contract_tx, contract_tx)
# demands a key scoped `ledger:adjust` and refuses the ordinary scopeless one with 403 — by
# design, so a new route can never hand an existing integration key a new power. The client
# fails closed rather than sending the wrong one.
PGAS_BEAMPAY_URL=http://127.0.0.1:8010
PGAS_BEAMPAY_KEY=                    # the ordinary key: /balances, /transactions, /withdraw, /create_wallet
PGAS_BEAMPAY_INTERNAL_KEY=           # the SCOPED key (ledger:adjust): /internal/expect_contract_tx, /internal/contract_tx
# ⛔ Unset, unscoped (403) or missing from the BeamPay build (master e09bfc2 has NO /internal/*
# routes at all) and NOTHING is signed: every release and every claim refuses with a written
# reason, because a contract txid that cannot be registered books its whole flow — the asset AND
# the BEAM fee — to __house__, and that repair can only be refused after the money has moved.
# The probe is `GET /internal/expect_contract_tx`, asked once per processor pass.
PGAS_BEAMPAY_TIMEOUT_S=20
# --- BeamPay -> us: the webhook credential ------------------------------------------------------
# BeamPay posts every money event to POST /internal/beampay/webhook and sends NO auth header, so
# the only credential it can carry is the one in the URL it was configured with. Generate one
# (`openssl rand -hex 32`), put it here, and give BeamPay the SAME value in its own .env:
#
#   BEAMPAY_WEBHOOK_URLS=http://127.0.0.1:8300/internal/beampay/webhook?token=<the same value>
#
# The two must match exactly, and neither is ever printed, logged or committed — the query string
# of every /internal/ access-log line is redacted (pgasme/main.py) for that reason.
# UNSET IS A REFUSAL: the route answers 503 and records nothing, because an unauthenticated
# writer of the evidence log is worse than a missing notification. Set it, then restart the API.
# ⚠️ A URL BeamPay cannot deliver to is not a quiet failure: its worker pages the operator's
# Telegram group on EVERY failed attempt and retries the record ~20 times (2026-09-10: seven
# "Webhook Failed" messages in minutes for one transaction). Wrong token = 401 = that flood.
# The endpoint only records; no credit, no deposit or payout change ever comes from a webhook.
PGAS_BEAMPAY_WEBHOOK_TOKEN=
# The regular address every claim books to and every shield spends from. Its BeamPay balance is
# the truth for claimed-but-not-yet-shielded value AND for the BEAM every claim, shield and pipe
# send is paid for. A balance read with no address is not a zero: every read RAISES while it is
# empty. Created through BeamPay (`POST /create_wallet {wallet_type: regular}`), never elsewhere.
PGAS_BEAM_TREASURY_ADDRESS=
PGAS_MIN_RELAYER_FEE_WEI=100000000000            # ETH: the smallest relayerFee ridden on the tail (1e11 wei)
PGAS_MIN_RELAYER_FEE_DAI_UNITS=200000000000000   # DAI: 0.0002 DAI
PGAS_MIN_RELAYER_FEE_WBTC_UNITS=1                # WBTC: 1 sat

# --- product economics -----------------------------------------------------------------------
PGAS_FEE_BPS=200                     # 2% at unlock, charged to the balance
PGAS_MIN_DEPOSIT_WEI=20000000000000000   # 0.02 ETH (ETH-equivalent for DAI/WBTC via CoinGecko)
PGAS_MIN_PAYOUT_GROTH=1              # 1 groth — a TECHNICAL floor, not an economic one (2026-09-10).
                                     # The withdrawal minimum is max(this, the asset's grid): a positive
                                     # amount that converts to a whole number of Ethereum units, nothing
                                     # more. There is no derived minimum any more — the bridge relayer fee
                                     # is CHARGED per item at cost (bridge_fee_groth = relayer_fee_now x
                                     # headroom-for-the-wait, quoted from the live gas price at request
                                     # time) instead of being paid out of our FEE_BPS cut, so nothing
                                     # economic depends on how big a payout is. Raise it only to impose a
                                     # product rule. GET /v1/withdrawals/fees reports what applies.
PGAS_DENOMINATIONS_GROTH=1000000,10000000   # instant-mode denominations (0.01, 0.1)
PGAS_BRIDGE_ETA_S=3960               # 66 min: an order wanted at T is released at T - this
# The FLOOR under the headroom the bridge fee carries. The curve is 1× now → 3× a full window
# out, and "1× now" means an ASAP order funds exactly the gas of the block its quote was taken
# in. Gas moves between two adjacent blocks: on 2026-09-10 two ASAP orders were quoted 14,733
# groth and the release pass measured 15,793 a few seconds later, so both were held "refusing to
# cross at a loss" on a crossing their user HAD paid for. Below 1 reads as 1 (config.py).
# ⚠️ DEPLOY: PGAS_BRIDGE_HEADROOM_MIN=1.25 (the default). IT STAYS AT 1.25 AFTER T45, and that
# is now a product choice: the unspent part of the bridge fee is REFUNDED to the user at
# settlement (`payouts._book_release` → the ledger's `bridge_fee_refund` entry), so headroom is
# a reservation rather than a charge — raising it would only park more of the user's money for
# the length of the wait, and lowering it puts the release gate back to work for nothing.
# ⚠️ With PGAS_MAX_RELAYER_SUBSIDY=4.0 this floor IS the whole curve: `headroom_for` divides the
# 3× far-dated margin by the subsidy, and 3/4 falls under it.
PGAS_BRIDGE_HEADROOM_MIN=1.25
PGAS_MAX_WINDOW_S=2592000            # 30 days — also the furthest ahead a delivery may be scheduled
PGAS_MAX_ITEMS_PER_WITHDRAWAL=50

# --- payout execution (DARK in this version; the API refuses the mode with 409 while 0) ------
PGAS_PAYOUT_DIRECT_ENABLED=0         # gates `releasing` only: the bETH -> ETH send to the user's W
PGAS_PAYOUT_INSTANT_ENABLED=0        # gates the INSTANT path: an Ethereum transfer to the user's W,
                                     # signed here, out of the distributor's own ETH float (T34,
                                     # 2026-09-10). No bridge, ~1 block. It also still gates the
                                     # designed-and-dark any-asset branch.
PGAS_INGRESS_NEAR_ENABLED=0

# --- the INSTANT payout distributor (pgasme/distributor.py) -----------------------------------
# ⛔ THE KEY LIVES IN A 0600 FILE ON THE BOX AND NOWHERE ELSE. This file names the PATH; the key
# itself is never in a repository, never in an argument list (`ps` publishes those), never in a
# log line and never in an alert. The API checks the mode at load and REFUSES a file any other
# account can read. One key, one address, one active distributor.
# CEREMONY (on the box, as root; the key is generated INSIDE the process and never printed —
# it is not an argument, so `ps` cannot see it, and only the ADDRESS reaches the terminal):
#   umask 077; mkdir -p /root/.pgasme
#   cd /opt/pgasme/api && .venv/bin/python - <<'EOF'
#   from eth_account import Account
#   import os
#   a = Account.create()
#   p = "/root/.pgasme/distributor-1.env"
#   open(p, "w").write("PGAS_DISTRIBUTOR_KEY=" + a.key.hex() + "\n")
#   os.chmod(p, 0o600)
#   print(a.address)          # ← the ONLY thing that leaves the process
#   EOF
#   ls -l /root/.pgasme/distributor-1.env      # must be -rw------- ; the API refuses anything else
# Then put the path in /etc/pgasme.env, restart pgasme-api, and check that the address the API
# derived is the same one the ceremony printed — that comparison IS the proof, and it needs no key:
#   curl -s http://127.0.0.1:8300/v1/health | python3 -m json.tool | grep -A3 distributor
# Fund that address with ETH (the admin, by hand, small first), or let a refill crossing do it.
PGAS_DISTRIBUTOR_KEY_FILE=           # e.g. /root/.pgasme/distributor-1.env — empty = no instant payouts
# The float policy. A refill is a bridge crossing of its own (~66 min + a bridge fee), so the
# floor is a TRIGGER and the target is the destination: topping up to the floor would turn one
# crossing into a permanent stream of them.
PGAS_DISTRIBUTOR_FLOAT_MIN_WEI=50000000000000000     # 0.05 ETH — below this, schedule a refill
PGAS_DISTRIBUTOR_FLOAT_TARGET_WEI=200000000000000000 # 0.2 ETH  — and go all the way back up to here
PGAS_INSTANT_GAS_LIMIT=21000         # a plain ETH transfer; there is no other kind on this path
PGAS_INSTANT_GAS_HEADROOM=1.25       # what the FLOAT GATE adds to the measured gas price, so a
                                     # base-fee tick between the gate and the block cannot make a
                                     # payout unpayable. Below 1 reads as 1.
PGAS_INSTANT_REBROADCAST_AFTER_S=120 # a signed transaction with no receipt goes out again after
                                     # this — THE SAME BYTES. One order signs one transaction.
PGAS_INSTANT_STUCK_AFTER_S=900       # …and after this the operator hears about it (a page, not a
                                     # refusal: the money is already on the wire). It is ALSO when
                                     # a transaction NO endpoint holds, on a nonce still free,
                                     # earns its ONE fee-bumped replacement — same nonce, same
                                     # destination, same value, so at most one can ever mine.
PGAS_INSTANT_CONFIRMATIONS=2         # the REORG FLOOR: blocks on top of the receipt before the
                                     # release is booked and the row reads `sent`. One
                                     # confirmation is a candidate, not a fact, and the ledger
                                     # has no un-send. ~25 s on mainnet. Never 0.

# --- Beam treasury + the order processors (pgasme/payouts.py) ---------------------------------
# EVERY money-moving flag here is 0 by default. With a flag off the handler logs what it WOULD
# do, marks the order `dark` and pages once an hour that treasury work is waiting. The operator
# flips these, after a dry run (`python -m pgasme.beam dry-run --payout <id>`), smallest first.
PGAS_CLAIM_ENABLED=0                 # 1 = `receive` the pipe message on Beam (spends 0.02 BEAM)
PGAS_SHIELD_ENABLED=0                # 1 = max-privacy self-sends into the pool (0.011 BEAM each)
PGAS_BEAM_SHADER=/opt/pgasme/beam/pipe_app.wasm   # the FORWARD pipe shader on the box
PGAS_BEAM_WALLET_TIMEOUT_S=30
# Shield denominations are a VALUE, not a number: 0.01/0.1 ETH is a crowd, and the same
# integers read as 0.01/0.1 DAI — 10,000 sends and 110 BEAM of fees for one 1000-DAI deposit.
PGAS_SHIELD_DENOMS_GROTH=1000000,10000000         # ETH:  0.01 / 0.1 ETH chunks
PGAS_SHIELD_DENOMS_DAI_GROTH=1000000000,10000000000   # DAI:  10 / 100 DAI
PGAS_SHIELD_DENOMS_WBTC_GROTH=1000000,10000000    # WBTC: 0.01 / 0.1 WBTC
PGAS_SHIELD_MAX_CHUNKS=64            # a longer plan is REFUSED and held, never emitted
PGAS_FLOAT_MIN_GROTH=0               # reserve kept in the shielded float; a release never eats it
# ── THE WORKING FLOAT (2026-09-10, T33). ⛔ SHIELDING IS NOT A MOVE BETWEEN TWO SPENDABLE
# PLACES. A max-privacy output is LOCKED after it settles — the wallet's own
# MaxPrivacyLockTimeLimitHours, default 72 — or until the anonymity-set target is reached, and
# on a pool growing ~28 outputs a day that target is never reached first. Measured on the box:
# three chunks confirmed at heights 4,030,052–4,030,127 and TEN HOURS LATER `wallet_status` for
# asset 36 still said `available_mp 0 / maturing_mp 1652864`. Value shielded is value no payout
# can spend for three days, so the treasury keeps a working float unshielded: this floor, AND
# every scheduled-but-unreleased payout (amount + its bridge fee) grossed up by the buffer.
# Only the excess is chunked; a chunk refused for the float writes a row and pages hourly.
# ⚠️ DEPLOY: PGAS_SHIELD_KEEP_GROTH=5000000 (0.05 ETH-equivalent) with PGAS_SHIELD_ENABLED=1.
PGAS_SHIELD_KEEP_GROTH=5000000       # 0.05 ETH-eq kept spendable at the treasury, always
PGAS_SHIELD_LIABILITY_BUFFER_BPS=1000  # +10% on the scheduled liabilities the float must cover
# ── WHICH SOURCE MAY FUND A CROSSING (2026-09-10, T33; admin: "in case we don't have available
# ETH for unlock to let people withdraw, let's keep bETH out of Lelantus" / "as Beam is private
# by default we can mix those BEAMs").
#   1 = the float is the shielded registry PLUS the treasury's unshielded balance; a release
#       picks ONE source, REGULAR FIRST (no lock), and registers its contract txid to THAT
#       source's address, so BeamPay debits the crossing and its BEAM fee where the value left.
#       It also RETIRES the §9.3/S2 gate below — see the privacy note there.
#   0 = the pre-2026-09-10 posture: shielded float only, S2 gate live.
# ⚠️ DEPLOY: PGAS_PAYOUT_SPEND_UNSHIELDED=1.
PGAS_PAYOUT_SPEND_UNSHIELDED=1
PGAS_PAYOUT_INTERVAL_S=30            # the payout_processor loop
PGAS_PAYOUT_LEASE_TTL_S=120          # one writer per resource: a second loop refuses to run
PGAS_HOLD_BACKOFF_S=300              # a row that just held is not re-read for this long
PGAS_BEAM_CONFIRMATIONS=61           # b2e: the relayer acts after ~61 Beam confirmations (~60 min)
# ⚠️ THESE TWO ARE BUDGETS, NOT SETTINGS (§WE-SET-IT-WE-DONT-READ-IT). They are what a pass
# RESERVES out of the treasury's asset-0 balance as BeamPay reports it, before it spends — so N
# calls cannot be admitted against one balance read. Neither reaches any wallet call: no `fee` is
# sent on invoke_contract (the WALLET sets it, exactly as arb_tracker's movers build theirs) and
# BeamPay overrides and ignores the fee field on /withdraw (it charges 0.001 BEAM to a regular
# address, 0.011 to an offline/max-privacy one). The fee actually charged is READ BACK from
# BeamPay once the transaction is booked and recorded on the row.
PGAS_BEAM_CLAIM_FEE_GROTH=2000000    # budget per contract invocation (claim / pipe send)
PGAS_BEAM_SHIELD_FEE_GROTH=1100000   # budget per shield chunk (BeamPay charges 0.011 to max_privacy)
# ── HOW MANY COINS, NOT HOW MUCH VALUE (T36). Beam locks a whole UTXO while a transaction that
# spends it is pending, so what bounds concurrency is the COUNT of spendable coins: 9.8 BEAM in
# ONE coin funds ONE call, and on 2026-09-10 10:30Z two releases 0.7 s apart both died "Not
# enough inputs". T40b's F12 then made a regular crossing spend BEAM TWICE (BeamPay's fee on the
# funding transfer, then the wallet's on the pipe invocation), so a fee coin is consumed per LEG.
# `beam status` prints target vs actual per asset and says `split needed: <assets>`; /v1/health
# carries `coins: {<asset>: {have, target}}` (counts only). The operator's fix is
# `python -m pgasme.beam split --asset BEAM|ETH|DAI|WBTC` — dry run by default.
PGAS_BEAM_FEE_COINS=20               # spendable BEAM coins that can each pay for a call
PGAS_BEAM_FEE_COIN_GROTH=15000000    # 0.15 BEAM — the FLOOR under one's size; the real size is
                                     # `fee_budget("send")` when that is higher, because a coin
                                     # below what a call costs is not a fee coin at all
PGAS_UTXO_TARGET_COINS=12            # spendable coins per PAYOUT asset (bETH / bDAI / bWBTC)
PGAS_BEAM_FEE_ALERT_GROTH=500000000  # 5 BEAM — the scale at which fee money matters, BOTH ways:
                                     # page below it in BALANCE (a starving wallet), and page
                                     # above it in ONE FEE read back (a fee nobody should pay)
PGAS_BEAM_MP_ADDRESS=                # our PRIMARY max_privacy address, created THROUGH BeamPay
                                     # (`/create_wallet {wallet_type: max_privacy}`) so its
                                     # balance is one BeamPay can report. Created once and
                                     # stored if empty.
                                     # ⚠️ IT IS NOT WHERE A SHIELD CHUNK IS SENT. 2026-09-09
                                     # 23:21–23:23Z: three max-privacy self-sends to THIS
                                     # address seconds apart — chunk 0 settled, chunks 1 and 2
                                     # came back "Shielded outp duplicate ← Kernel Type 3"
                                     # (status 4, failed maximum anonymity). A max-privacy
                                     # address publishes ONE-TIME vouchers and the wallet
                                     # re-used one for every send. So each chunk now gets its
                                     # OWN fresh max_privacy address, registered in the
                                     # `mp_addresses` collection, and the SHIELDED FLOAT is the
                                     # SUM of `available` over that registry PLUS this address.
                                     # This one stays load-bearing: it is the registry's first
                                     # entry and the address a release registers its contract
                                     # txid to, so BeamPay books the crossing and its BEAM fee
                                     # there.
                                     # ⚠️ PROVEN before any chunk, and BeamPay's
                                     # /validate_address answers only `is_valid`, so the proof is
                                     # valid · in BeamPay's own address book (the `is_mine`
                                     # substitute, and what makes the float readable at all) ·
                                     # NOT a 64/66-hex regular address (shielding to one settles
                                     # and shields nothing). A typo here otherwise sends every
                                     # claimed deposit to a stranger, one settled kernel at a time
                                     # Repair a shielding that failed:
                                     #   python -m pgasme.beam replan-shield --deposit <id>
                                     #   …then the same with --apply (a dry run writes nothing)
PGAS_RELAYER_FEE_MARGIN=1.5          # bridge_fee.py FEE_MARGIN — insurance against REFUSAL, not speed
PGAS_MAX_RELAYER_SHARE=0.10          # refuse a crossing whose relayer fee exceeds this share of
                                     # the amount — a LEGACY-ROW gate since 2026-09-10. A row
                                     # that funded its own crossing is not measured against a
                                     # share of the amount at all: with a 1-groth floor that
                                     # gate holds every small payout the product exists for,
                                     # each one already paid for in full by its own bridge fee
# ⚠️ DEPLOY: PGAS_MAX_RELAYER_SUBSIDY=4.0 — the default since T45 (2026-09-10). A bridge fee is
# $0.10–0.20 at ordinary mainnet gas, so absorbing even a 4× spike costs cents — and the
# alternative is holding an order the user has already paid for in full. On 2026-09-10 two ASAP
# orders funded 14,733 groth and the release pass measured 15,793 seconds later (at 1.0 both were
# held); order d028 funded 14,770 and the crossing wanted 24,299, and only the subsidy delivered
# it. What we absorb is written on the row as `relayer_subsidy_groth` — a loss an operator can
# add up, never an invisible one.
# ⚠️ IT ALSO FLATTENS THE HEADROOM CURVE, on purpose: `routers/withdrawals.headroom_for` divides
# the 3×-at-max-window margin by this number, so at 4.0 every window quotes the
# PGAS_BRIDGE_HEADROOM_MIN floor (1.25). The gate carries the wait instead of the user's balance
# carrying it for a month — and since T45 whatever the crossing does not spend is refunded to the
# user at settlement (`bridge_fee_refund` in the ledger), so headroom is a reservation, not a fee.
PGAS_MAX_RELAYER_SUBSIDY=4.0         # …and this multiple of the bridge fee THE ORDER FUNDED
                                     # (`bridge_fee_groth` on the row: the user pays the
                                     # crossing at cost since 2026-09-10; a row written before
                                     # that falls back to the 2% that WAS its budget then —
                                     # payouts.bridge_budget_groth is the one reader).
                                     # 1.0 = never cross at a loss (the treasury's own guard).
                                     # ⚠️ 0, unset, or anything below 1 all read as 1×:
                                     # config.relayer_subsidy() is the ONE reader, and BOTH the
                                     # charge (the headroom inside the bridge fee we quote) and
                                     # the release gate go through it. Read two ways, a 0 here
                                     # quoted a 1× crossing and then held every order for ever
# §9.3 / spec question S2 is UNANSWERED: nobody has proven which inputs the wallet picks for a
# `role=user,action=send` invocation. While this is 0 a release refuses whenever ANY unshielded
# balance of that asset exists — a send funded from a freshly-claimed regular output is the
# deposit↔payout link the product exists to prevent. Prove it on the box, then set it.
# ⚠️ 2026-09-10: that gate is RETIRED whenever PGAS_PAYOUT_SPEND_UNSHIELDED=1 (above), which is
# this deployment's posture. What it gave up, plainly: a regular-funded crossing can be linked
# on-chain to the claim UTXO that created it, so deposit and payout join one graph. AMOUNTS AND
# ADDRESSES STAY BLINDED (Beam's base layer hides both) — what leaks is the link, not the
# numbers. Shielding still runs and still breaks that link for everything it covers; the
# product simply no longer refuses to pay while it waits three days for the lock to expire.
PGAS_BEAM_SEND_INPUTS_PROVEN=0
PGAS_BEAM_REGULAR_TOLERANCE_GROTH=0  # dust of unshielded balance the proof allows to be ignored

# --- external reads --------------------------------------------------------------------------
PGAS_EXPLORER_BASE=https://beamsmart.net:8000    # /status → shielded pool numbers
PGAS_COINGECKO_BASE=https://api.coingecko.com/api/v3

# --- workers ---------------------------------------------------------------------------------
PGAS_WATCHER_INTERVAL_S=15
PGAS_MONITOR_INTERVAL_S=60
PGAS_STATS_INTERVAL_S=60
PGAS_DEPOSIT_FALLBACK_AFTER_S=1800   # Fulfilled with no lock log for 30 min → fallback_pending

# --- hosted token lists (pgasme/tokens.py) ----------------------------------------------------
# The refresher writes <evm chain id>.json (+ .json.gz + manifest.json) into this directory and
# nginx serves it as /tokens/ (see deploy/nginx-pgas.me.conf); the API only reads the manifest,
# for /v1/health.tokens. The client fetches the static file first and falls back to
# /v1/dex/tokens when it is missing, so an unwritable directory is slow, never broken — it pages
# once and the API keeps answering.
PGAS_TOKENS_DIR=/opt/pgasme/tokens
PGAS_TOKENS_REFRESH_INTERVAL_S=21600 # 6 h; the underlying lists change daily at most

# --- Telegram (DEFAULT-DENY: nothing is sent unless PGAS_TG_LIVE=1 AND token AND chat id) ----
# ⚠️ "never logged" is now ENFORCED, not promised: on 2026-09-10 httpx's INFO logger wrote the
# send url — which carries this token — into the API's log file 21 times. pgasme/main.py holds
# httpx/httpcore at WARNING and masks `bot<digits>:<secret>` in every log record either way.
PGAS_TG_BOT_TOKEN=                   # bot token — only in the server .env, never logged
PGAS_TG_CHAT_ID=                     # operator group / chat id
PGAS_TG_LIVE=0                       # 1 = really send; anything else logs [tg-muted] and sends nothing
